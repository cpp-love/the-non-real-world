{
    "version": "2.0.0",
    "inputs": [
        {
            "id": "generateFiles",
            "type": "promptString",
            "description": "选择相对当前工作区目录的要生成版本文档的文件（夹）"
        }
    ],
    "tasks": [
        {
            "label": "C/C++: 输出代码问题到文件",
            "type": "shell",
            "command": "python",
            "args": [
                "${workspaceFolder}/helper/generate_code_issues.py",
                "-p",
                "${command:cmake.buildDirectory}/compile_commands.json",
                "-ea=-stdlib=libc++",
                "-ea=-idirafter",
                "-ea=C:/msys64/ucrt64/include",
                "-fd",
                "${workspaceFolder}/helper",
                "-fd",
                "${workspaceFolder}/include",
                "-fd",
                "${workspaceFolder}/src",
                "-fd",
                "${workspaceFolder}/tests"
            ],
            "problemMatcher": [],
            "detail": "输出tnrw代码问题到文件的任务"
        },
        {
            "label": "C/C++: 生成文件版本文件",
            "type": "shell",
            "command": "${command:cmake.buildDirectory}/bin/generate_file_version",
            "args": [
                "${workspaceFolder}",
                "${file}",
                "'cpp-love(15865418+cpp-love@user.noreply.gitee.com)'"
            ],
            "problemMatcher": [],
            "detail": "输出文件版本文件的任务",
            "runOptions": {
                "instanceLimit": 10
            }
        },
        {
            "label": "C/C++: 生成文件版本文件（选择版）",
            "type": "shell",
            "command": "${command:cmake.buildDirectory}/bin/generate_file_version",
            "args": [
                "${workspaceFolder}",
                "${workspaceFolder}/${input:generateFiles}",
                "'cpp-love(15865418+cpp-love@user.noreply.gitee.com)'"
            ],
            "problemMatcher": [],
            "detail": "输出文件版本文件的任务",
            "runOptions": {
                "instanceLimit": 10
            }
        },
        {
            "label": "C/C++: doxygen 生成文档（公共）",
            "type": "shell",
            "command": "doxygen", // 生成 Doxygen 文档
            "args": [
                "${workspaceFolder}/Doxyfile"
            ],
            "problemMatcher": [],
            "detail": "生成 Doxygen 公共文档的任务"
        },
        {
            "label": "C/C++: doxygen 生成文档（内部）",
            "type": "shell",
            "command": "doxygen", // 生成 Doxygen 文档
            "args": [
                "${workspaceFolder}/Doxyfile.internal"
            ],
            "problemMatcher": [],
            "detail": "生成 Doxygen 内部文档的任务"
        }
    ]
}