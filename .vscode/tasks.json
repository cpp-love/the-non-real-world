{
    "version": "2.0.0",
    "inputs": [
        {
            "id": "generateFiles",
            "type": "promptString",
            "description": "选择相对当前工作区目录的要生成版本文档的文件（夹）"
        }
    ],
    "tasks": [
        {
            "label": "C/C++: 生成文件版本文件",
            "type": "shell",
            "command": "${command:cmake.buildDirectory}/bin/generate_file_version",
            "args": [
                "${workspaceFolder}",
                "${file}",
                "'cpp-love(15865418+cpp-love@user.noreply.gitee.com)'"
            ],
            "problemMatcher": [],
            "detail": "输出文件版本文件的任务"
        },
        {
            "label": "C/C++: 生成文件版本文件（选择版）",
            "type": "shell",
            "command": "${command:cmake.buildDirectory}/bin/generate_file_version",
            "args": [
                "${workspaceFolder}",
                "${workspaceFolder}/${input:generateFiles}",
                "'cpp-love(15865418+cpp-love@user.noreply.gitee.com)'"
            ],
            "problemMatcher": [],
            "detail": "输出文件版本文件的任务"
        },
        {
            "label": "C/C++: doxygen 生成文档（公共）",
            "type": "shell",
            "command": "doxygen", // 生成 Doxygen 文档
            "args": [
                "${workspaceFolder}/Doxyfile"
            ],
            "problemMatcher": [],
            "detail": "生成 Doxygen 公共文档的任务"
        },
        {
            "label": "C/C++: doxygen 生成文档（内部）",
            "type": "shell",
            "command": "doxygen", // 生成 Doxygen 文档
            "args": [
                "${workspaceFolder}/Doxyfile.internal"
            ],
            "problemMatcher": [],
            "detail": "生成 Doxygen 内部文档的任务"
        }
    ]
}