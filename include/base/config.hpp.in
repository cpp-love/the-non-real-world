#include <cstdint>

#ifndef __BASE_CONFIG_HPP__
#define __BASE_CONFIG_HPP__

namespace tnrw {
    using version_type = std::uint16_t;
    using level_identifier_type = std::uint16_t;
    constexpr version_type version_major_offset = 11;
    constexpr version_type version_major = @TheNon-realWorld_VERSION_MAJOR@;
    constexpr version_type version_minor_offset = 6;
    constexpr version_type version_minor = @TheNon-realWorld_VERSION_MINOR@;
    constexpr version_type version_patch_offset = 0;
    constexpr version_type version_patch = @TheNon-realWorld_VERSION_PATCH@;
    constexpr version_type version = (version_major << version_major_offset)
                                     + (version_minor << version_minor_offset)
                                     + (version_patch << version_patch_offset);
} // namespace tnrw

#endif // __BASE_CONFIG_HPP__