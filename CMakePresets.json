            "generator": "Ninja",
            "cacheVariables": {
                "TNRW_BUILD_HELPER": "ON",
                "TNRW_BUILD_TESTS": "ON",
                "TNRW_USE_FMT_OUTPUT": "ON"
            }
        },
        {
