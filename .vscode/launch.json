{
    "version": "0.2.0",
    // 使用 IntelliSense 了解相关属性。 
    // 悬停以查看现有属性的描述。
    // 欲了解更多信息，请访问: https://go.microsoft.com/fwlink/?linkid=830387
    "inputs": [
        {
            "id": "selectExe",
            "type": "promptString",
            "description": "输入相对于构建目录的可执行路径，例如: myapp.exe 或 subdir/app.exe",
        }
    ],
    "configurations": [
        {
            "name": "C/C++: Windows 运行活动文件（可选择）",
            "type": "cppvsdbg",
            "request": "launch",
            "program": "${command:cmake.buildDirectory}/bin/${input:selectExe}",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${command:cmake.buildDirectory}/bin",
            "environment": []
        },
        {
            "name": "C/C++: gdb.exe 调试活动文件（可选择）",
            "type": "cppdbg",
            "request": "launch",
            "program": "${command:cmake.buildDirectory}/bin/${input:selectExe}",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${command:cmake.buildDirectory}/bin",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "C:/msys64/ucrt64/bin/gdb.exe",
            "setupCommands": [
                {
                    "description": "为 gdb 启用整齐打印",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
                {
                    "description": "将反汇编风格设置为 Intel",
                    "text": "-gdb-set disassembly-flavor intel",
                    "ignoreFailures": true
                }
            ]
        },
        {
            "name": "C/C++: lldb.exe 调试活动文件（可选择）",
            "type": "lldb",
            "request": "launch",
            "program": "${command:cmake.buildDirectory}/bin/${input:selectExe}",
            "args": [],
            "stopOnEntry": false,
            "cwd": "${command:cmake.buildDirectory}/bin",
            "console": "integratedTerminal"
        }
    ]
}